# 이 파일을 같은 폴더에 .env 라는 이름으로 복사한 뒤 값을 넣는다.
# 값을 넣지 않아도 프로그램은 규칙 모드로 끝까지 돈다(세 칸 선택).
# 운영체제의 환경변수에 같은 이름이 있으면 환경변수가 먼저다.

# Claude API Key. 넣으면 LLM 모드(목적 문장 해석, 타협안 선택, 이유 설명)가 켜진다.
ANTHROPIC_API_KEY=

# 쓸 모델. 비우면 claude-haiku-5-5 (Claude 의 저가 등급인 Haiku 계열).
MODEL=

# API 주소. 비우면 https://api.anthropic.com
API_BASE=

# 동네 미리 보기(공개 Open API). 비우면 그 줄만 화면에서 빠진다. 받는 법은 사용자 매뉴얼 5.3절.
# 제주데이터허브 프로젝트 키(583 읍면동 단위 내국인 유동인구)
JEJU_HUB_KEY=
# 공공데이터포털 소상공인시장진흥공단 상가(상권)정보 인증키(인코딩 키 그대로 넣어도 된다)
SBIZ_STORE_KEY=
# 소상공인365 간단분석 certKey
SBIZ365_CERT_KEY=
